<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#F8FAFC"
    app:strokeWidth="1dp"
    app:strokeColor="#F1F5F9">

    <com.google.android.flexbox.FlexboxLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="8dp"
        android:paddingVertical="12dp"
        app:flexWrap="wrap"
        app:justifyContent="center"
        app:alignItems="center">

        <!-- Legend Item: Completed -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/shape_legend_completed" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Completed"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#64748B" />
        </LinearLayout>

        <!-- Legend Item: Missed -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/shape_legend_missed" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Missed"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#64748B" />
        </LinearLayout>

        <!-- Legend Item: Today -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/shape_legend_today" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Today"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#64748B" />
        </LinearLayout>

        <!-- Legend Item: Planned -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/shape_legend_habit" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Planned"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#64748B" />
        </LinearLayout>

        <!-- Legend Item: Off-day -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <View
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/shape_legend_not_habit" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Off-day"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#64748B" />
        </LinearLayout>

    </com.google.android.flexbox.FlexboxLayout>

</com.google.android.material.card.MaterialCardView>
