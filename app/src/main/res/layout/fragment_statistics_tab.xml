<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/contentLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/habitScoreCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="@android:color/transparent"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Today's Completion Rate"
                            android:textSize="18sp"
                            android:textColor="@color/primary_blue"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginBottom="24dp" />

                    <FrameLayout
                        android:layout_width="200dp"
                        android:layout_height="200dp">

                        <ProgressBar
                            android:id="@+id/progressCircle"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:indeterminate="false"
                            android:max="100"
                            android:progress="80"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:progressDrawable="@drawable/circular_progress" />

                        <TextView
                            android:id="@+id/tvHabitScore"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="80%"
                            android:textSize="48sp"
                            android:textColor="@color/primary_blue"
                            android:fontFamily="sans-serif-medium" />
                    </FrameLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/chartCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="@android:color/transparent"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="This Week"
                        android:textSize="18sp"
                        android:textColor="@color/primary_blue"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="24dp" />

                    <!-- Chart with Y-axis and Grid -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Y-axis Label -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:text="Completed Habits"
                            android:textSize="10sp"
                            android:textColor="@color/secondary_gray"
                            android:gravity="center"
                            android:rotation="-90"
                            android:layout_marginEnd="-30dp"
                            android:layout_marginStart="-30dp" />

                        <!-- Y-axis Labels -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="200dp"
                            android:orientation="vertical"
                            android:gravity="end"
                            android:layout_marginEnd="8dp">

                            <TextView
                                android:id="@+id/tvYAxisMax"
                                android:layout_width="wrap_content"
                                android:layout_height="0dp"
                                android:layout_weight="1"
                                android:text="10"
                                android:textSize="10sp"
                                android:textColor="@color/secondary_gray"
                                android:gravity="top" />

                            <TextView
                                android:id="@+id/tvYAxisMid"
                                android:layout_width="wrap_content"
                                android:layout_height="0dp"
                                android:layout_weight="1"
                                android:text="5"
                                android:textSize="10sp"
                                android:textColor="@color/secondary_gray"
                                android:gravity="center_vertical" />

                            <TextView
                                android:id="@+id/tvYAxisMin"
                                android:layout_width="wrap_content"
                                android:layout_height="0dp"
                                android:layout_weight="1"
                                android:text="0"
                                android:textSize="10sp"
                                android:textColor="@color/secondary_gray"
                                android:gravity="bottom"
                                android:layout_marginBottom="20dp" />
                        </LinearLayout>

                        <!-- Chart Area with Grid -->
                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="200dp"
                            android:layout_weight="1">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <!-- Grid Lines -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:layout_marginBottom="20dp">

                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="1dp"
                                    android:background="@color/secondary_gray"
                                    android:alpha="0.2" />

                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="0dp"
                                    android:layout_weight="1" />

                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="1dp"
                                    android:background="@color/secondary_gray"
                                    android:alpha="0.2" />

                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="0dp"
                                    android:layout_weight="1" />

                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="1dp"
                                    android:background="@color/secondary_gray"
                                    android:alpha="0.3" />
                            </LinearLayout>

                            <!-- Bar Chart -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="horizontal"
                                android:gravity="bottom"
                                android:weightSum="7">

                    <LinearLayout
                        android:id="@+id/barContainerSun"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal|bottom"
                        android:layout_marginHorizontal="4dp"
                        android:clickable="true"
                        android:focusable="true">

                        <View
                            android:id="@+id/barSun"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_chart_bar"
                            android:backgroundTint="@color/accent_blue"
                            android:alpha="0.6" />

                        <TextView
                            android:id="@+id/tvSun"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sun"
                            android:textSize="10sp"
                            android:textColor="@color/secondary_gray"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/barContainerMon"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal|bottom"
                        android:layout_marginHorizontal="4dp"
                        android:clickable="true"
                        android:focusable="true">

                        <View
                            android:id="@+id/barMon"
                            android:layout_width="match_parent"
                            android:layout_height="80dp"
                            android:background="@drawable/bg_chart_bar"
                            android:backgroundTint="@color/accent_blue"
                            android:alpha="0.7" />

                        <TextView
                            android:id="@+id/tvMon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mon"
                            android:textSize="10sp"
                            android:textColor="@color/secondary_gray"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/barContainerTue"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal|bottom"
                        android:layout_marginHorizontal="4dp"
                        android:clickable="true"
                        android:focusable="true">

                        <View
                            android:id="@+id/barTue"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:background="@drawable/bg_chart_bar"
                            android:backgroundTint="@color/accent_blue"
                            android:alpha="0.8" />

                        <TextView
                            android:id="@+id/tvTue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tue"
                            android:textSize="10sp"
                            android:textColor="@color/secondary_gray"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/barContainerWed"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal|bottom"
                        android:layout_marginHorizontal="4dp"
                        android:clickable="true"
                        android:focusable="true">

                        <View
                            android:id="@+id/barWed"
                            android:layout_width="match_parent"
                            android:layout_height="100dp"
                            android:background="@drawable/bg_chart_bar"
                            android:backgroundTint="@color/accent_blue"
                            android:alpha="0.9" />

                        <TextView
                            android:id="@+id/tvWed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Wed"
                            android:textSize="10sp"
                            android:textColor="@color/secondary_gray"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/barContainerThu"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal|bottom"
                        android:layout_marginHorizontal="4dp"
                        android:clickable="true"
                        android:focusable="true">

                        <View
                            android:id="@+id/barThu"
                            android:layout_width="match_parent"
                            android:layout_height="70dp"
                            android:background="@drawable/bg_chart_bar"
                            android:backgroundTint="@color/accent_blue"
                            android:alpha="0.7" />

                        <TextView
                            android:id="@+id/tvThu"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Thu"
                            android:textSize="10sp"
                            android:textColor="@color/secondary_gray"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/barContainerFri"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal|bottom"
                        android:layout_marginHorizontal="4dp"
                        android:clickable="true"
                        android:focusable="true">

                        <View
                            android:id="@+id/barFri"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:background="@drawable/bg_chart_bar"
                            android:backgroundTint="@color/accent_blue"
                            android:alpha="0.6" />

                        <TextView
                            android:id="@+id/tvFri"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Fri"
                            android:textSize="10sp"
                            android:textColor="@color/secondary_gray"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/barContainerSat"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal|bottom"
                        android:layout_marginHorizontal="4dp"
                        android:clickable="true"
                        android:focusable="true">

                        <View
                            android:id="@+id/barSat"
                            android:layout_width="match_parent"
                            android:layout_height="90dp"
                            android:background="@drawable/bg_chart_bar"
                            android:backgroundTint="@color/accent_blue"
                            android:alpha="0.8" />

                        <TextView
                            android:id="@+id/tvSat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sat"
                            android:textSize="10sp"
                            android:textColor="@color/secondary_gray"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>

                        </LinearLayout>
                    </RelativeLayout>

                    <!-- Tooltip Container -->
                    <FrameLayout
                        android:id="@+id/tooltipContainer"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone" />

                    </FrameLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="4dp"
                    android:text="Day of Week"
                    android:textSize="10sp"
                    android:textColor="@color/secondary_gray"
                    android:alpha="0.5" />

                <!-- Legend -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_gravity="center_horizontal"
                    app:cardCornerRadius="100dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#F8FAFC"
                    app:strokeWidth="1dp"
                    app:strokeColor="#F1F5F9">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:gravity="center_vertical">

                        <View
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/bg_legend_item"
                            android:backgroundTint="@color/accent_blue" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Completed Habits Count"
                            android:textSize="11sp"
                            android:textColor="@color/secondary_gray"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Weekly Statistics Summary -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#F0F7FF"
                        app:strokeWidth="1dp"
                        app:strokeColor="#E0EEFF">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:gravity="center">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_check"
                                app:tint="@color/accent_blue"
                                android:layout_marginBottom="8dp"
                                 />

                            <TextView
                                android:id="@+id/tvTotalCompletedHabits"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textSize="20sp"
                                android:textColor="@color/primary_blue"
                                android:fontFamily="sans-serif-black" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/weekly_total"
                                android:textSize="11sp"
                                android:textColor="@color/secondary_gray"
                                android:fontFamily="sans-serif-medium" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#F0F7FF"
                        app:strokeWidth="1dp"
                        app:strokeColor="#E0EEFF">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:gravity="center">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_report"
                                app:tint="@color/accent_blue"
                                android:layout_marginBottom="8dp"
                                android:contentDescription="@string/avg_success" />

                            <TextView
                                android:id="@+id/tvWeeklyCompletionRate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0%"
                                android:textSize="20sp"
                                android:textColor="@color/primary_blue"
                                android:fontFamily="sans-serif-black" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/avg_success"
                                android:textSize="11sp"
                                android:textColor="@color/secondary_gray"
                                android:fontFamily="sans-serif-medium" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        </LinearLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
